# =============================================================
# Kamra – environment variables template
# Másold .env-re és töltsd ki az értékeket. A .env soha ne kerüljön
# verziókezelőbe (lásd .gitignore).
# =============================================================

# ===== PostgreSQL =====
POSTGRES_DB=pantry
POSTGRES_USER=pantry_user
POSTGRES_PASSWORD=change_me                  # csak példa, a valódi jelszó a .env-ben van
POSTGRES_PORT=5432
# Az API ezt használja (a .NET-ben ConnectionStrings__Default néven olvasható)
ConnectionStrings__Default=Host=localhost;Port=5432;Database=pantry;Username=pantry_user;Password=change_me

# ===== Autentikáció (ha lesz felhasználókezelés) =====
Jwt__Secret=change_me_min_32_chars_long
Jwt__Issuer=pantry-api
Jwt__ExpiryMinutes=60

# ===== AI / LLM (ChatCompletion API) =====
LLM_API_KEY=your_api_key_here                # soha ne kerüljön a repóba
LLM_MODEL=model-name-here
LLM_BASE_URL=https://api.example.com/v1      # a választott szolgáltatóé
LLM_TIMEOUT_SECONDS=30

# ===== MCP szerver =====
MCP_SERVER_URL=http://localhost:5100
MCP_SERVER_PORT=5100
