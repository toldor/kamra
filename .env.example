# =============================================================
# Kamra – environment variables template
# Másold .env-re és töltsd ki az értékeket. A .env soha ne kerüljön
# verziókezelőbe (lásd .gitignore).
# =============================================================

# ===== PostgreSQL =====
POSTGRES_DB=pantry
POSTGRES_USER=pantry_user
POSTGRES_PASSWORD=change_me                  # csak példa, a valódi jelszó a .env-ben van
POSTGRES_PORT=5432
# Az API ezt használja (a .NET-ben ConnectionStrings__Default néven olvasható)
ConnectionStrings__Default=Host=localhost;Port=5432;Database=pantry;Username=pantry_user;Password=change_me

# ===== Docker Compose =====
# Az Api (és a SPA) portja a gépen: http://localhost:8080
API_PORT=8080

# ===== Autentikáció (cookie, ADR-0006) =====
# A cookie- és antiforgery-kulcsok helye; Docker Compose-ban volume-ra mutat, hogy újraindítás után
# is érvényes maradjon a bejelentkezés. Üresen hagyva a keretrendszer alapértelmezett helye.
DataProtection__KeysPath=
# Bejelentkezés és regisztráció: kérések száma IP-címenként egy időablakban.
RateLimiting__Auth__PermitLimit=10
RateLimiting__Auth__WindowSeconds=60
