# =============================================================
# Kamra – environment variables template
# Másold .env-re és töltsd ki az értékeket. A .env soha ne kerüljön
# verziókezelőbe (lásd .gitignore).
# =============================================================

# ===== PostgreSQL =====
POSTGRES_DB=pantry
POSTGRES_USER=pantry_user
POSTGRES_PASSWORD=change_me                  # csak példa, a valódi jelszó a .env-ben van
POSTGRES_PORT=5432
# Az API ezt használja (a .NET-ben ConnectionStrings__Default néven olvasható)
ConnectionStrings__Default=Host=localhost;Port=5432;Database=pantry;Username=pantry_user;Password=change_me

# ===== Docker Compose =====
# Az Api (és a SPA) portja a gépen: http://localhost:8080
API_PORT=8080

# ===== Autentikáció (cookie, ADR-0006) =====
# A cookie- és antiforgery-kulcsok helye; Docker Compose-ban volume-ra mutat, hogy újraindítás után
# is érvényes maradjon a bejelentkezés. Üresen hagyva a keretrendszer alapértelmezett helye.
DataProtection__KeysPath=
# Bejelentkezés és regisztráció: kérések száma IP-címenként egy időablakban.
RateLimiting__Auth__PermitLimit=10
RateLimiting__Auth__WindowSeconds=60

# ===== Mondatos bevitel (US-2, ADR-0009) =====
# Alapból kikapcsolva: a mondatos bevitel nem látszik, a kézi rögzítés működik.
# Bekapcsoláshoz kell a Gemini API-kulcs (Google AI Studio); kulcs nélkül az alkalmazás nem indul el.
# A kulcsot csak a .env-be írd, soha ne a repóba.
Llm__Enabled=false
Llm__ApiKey=
# Mondatos beküldések háztartásonként egy időablakban (alapból 20 / 10 perc).
RateLimiting__ItemProposals__PermitLimit=20
RateLimiting__ItemProposals__WindowSeconds=600

# ===== Kérdezz – csak olvasó chat (US-6, ADR-0010) =====
# Ugyanaz a kapcsoló és kulcs, mint a mondatos bevitelé (Llm__Enabled, Llm__ApiKey).
# A chat modellje; üresen ugyanaz, mint a mondatos bevitelé (gemini-3.1-flash-lite).
# Llm__ChatModel=
# Kérdések háztartásonként egy időablakban (alapból 30 / 10 perc).
RateLimiting__Chat__PermitLimit=30
RateLimiting__Chat__WindowSeconds=600
