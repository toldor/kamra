<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- ADR-0007: openapi.json is generated on build and committed; CI fails if it changes. -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KamraApp.Application\KamraApp.Application.csproj" />
    <ProjectReference Include="..\KamraApp.Infrastructure\KamraApp.Infrastructure.csproj" />
  </ItemGroup>

</Project>
