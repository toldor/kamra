  "components": {
    "schemas": {
      "AcceptShoppingSuggestionRequest": {
        "type": "object",
        "properties": {
          "amount": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "unit": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AddPantryItemRequest": {
        "required": [
          "ingredientId",
          "amount",
          "unit"
        ],
        "type": "object",
        "properties": {
          "ingredientId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "amount": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "unit": {
            "type": [
              "null",
              "string"
            ]
          },
          "category": {
            "type": [
              "null",
              "string"
            ]
          },
          "expiryDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          }
        }
      },
      "AddShoppingListItemRequest": {
        "required": [
          "ingredientId"
        ],
        "type": "object",
        "properties": {
          "ingredientId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "amount": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "unit": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AmountResponse": {
        "required": [
          "value",
          "unit"
        ],
        "type": "object",
        "properties": {
          "value": {
            "type": "number",
            "format": "double"
          },
          "unit": {
            "$ref": "#/components/schemas/Unit"
          }
        }
      },
      "AntiforgeryTokenResponse": {
        "required": [
          "requestToken"
        ],
        "type": "object",
        "properties": {
          "requestToken": {
            "type": "string"
          }
        }
      },
      "Category": {
        "enum": [
          "dairy",
          "cheese",
          "eggs",
          "freshMeatFish",
          "processedMeat",
          "vegetables",
          "fruit",
          "bakery",
          "dryGoods",
          "cannedAndSauces",
          "frozen",
          "beverages",
          "preparedFood",
          "other"
        ]
      },
      "CategoryResponse": {
        "required": [
          "category",
          "shelfLifeDays"
        ],
        "type": "object",
        "properties": {
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "shelfLifeDays": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          }
        }
      },
      "ConfirmCookingRequest": {
        "required": [
          "requestId",
          "recipeId",
          "servings",
          "used"
        ],
        "type": "object",
        "properties": {
          "requestId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "recipeId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "servings": {
            "maximum": 100,
            "minimum": 1,
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "used": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/UsedAmount"
            }
          }
        }
      },
      "CookingAllocation": {
        "required": [
          "expiryDate",
          "amount",
          "expired"
        ],
        "type": "object",
        "properties": {
          "expiryDate": {
            "type": "string",
            "format": "date"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "expired": {
            "type": "boolean"
          }
        }
      },
      "CookingPreviewLine": {
        "required": [
          "ingredientId",
          "ingredientName",
          "unit",
          "required",
          "available",
          "defaultUsed",
          "shortage",
          "allocations"
        ],
        "type": "object",
        "properties": {
          "ingredientId": {
            "type": "string",
            "format": "uuid"
          },
          "ingredientName": {
            "type": "string"
          },
          "unit": {
            "$ref": "#/components/schemas/Unit"
          },
          "required": {
            "type": "number",
            "format": "double"
          },
          "available": {
            "type": "number",
            "format": "double"
          },
          "defaultUsed": {
            "type": "number",
            "format": "double"
          },
          "shortage": {
            "type": "number",
            "format": "double"
          },
          "allocations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CookingAllocation"
            }
          }
        }
      },
      "CookingPreviewResponse": {
        "required": [
          "recipeId",
          "name",
          "servings",
          "recipeServings",
          "instructions",
          "staples",
          "lines"
        ],
        "type": "object",
        "properties": {
          "recipeId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "servings": {
            "type": "integer",
            "format": "int32"
          },
          "recipeServings": {
            "type": "integer",
            "format": "int32"
          },
          "instructions": {
            "type": "string"
          },
          "staples": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CookingPreviewLine"
            }
