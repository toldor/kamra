{
  "openapi": "3.1.1",
  "info": {
    "title": "KamraApp.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/categories": {
      "get": {
        "tags": [
          "Categories"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CategoryResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ingredients": {
      "get": {
        "tags": [
          "Ingredients"
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IngredientResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pantry-items": {
      "get": {
        "tags": [
          "PantryItems"
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "expiringSoon",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PantryItemResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "PantryItems"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/AddPantryItemRequest"
                  }
                ]
              }
            },
            "text/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/AddPantryItemRequest"
                  }
                ]
              }
            },
            "application/*+json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/AddPantryItemRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/PantryItemResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PantryItemResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/PantryItemResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pantry-items/{id}": {
      "put": {
        "tags": [
          "PantryItems"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/UpdatePantryItemRequest"
                  }
                ]
              }
            },
            "text/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/UpdatePantryItemRequest"
                  }
                ]
              }
            },
            "application/*+json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/UpdatePantryItemRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PantryItemResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/RegisterRequest"
                  }
                ]
              }
            },
            "text/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/RegisterRequest"
                  }
                ]
              }
            },
            "application/*+json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/RegisterRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/LoginRequest"
                  }
                ]
              }
            },
            "text/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/LoginRequest"
                  }
                ]
              }
            },
            "application/*+json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/LoginRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/antiforgery": {
      "get": {
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AntiforgeryTokenResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddPantryItemRequest": {
        "required": [
          "ingredientId",
          "amount",
          "unit"
        ],
        "type": "object",
        "properties": {
          "ingredientId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "amount": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "unit": {
            "type": [
              "null",
              "string"
            ]
          },
          "category": {
            "type": [
              "null",
              "string"
            ]
          },
          "expiryDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          }
        }
      },
      "AntiforgeryTokenResponse": {
        "required": [
          "requestToken"
        ],
        "type": "object",
        "properties": {
          "requestToken": {
            "type": "string"
          }
        }
      },
      "Category": {
        "enum": [
          "dairy",
          "cheese",
          "eggs",
          "freshMeatFish",
          "processedMeat",
          "vegetables",
          "fruit",
          "bakery",
          "dryGoods",
          "cannedAndSauces",
          "frozen",
          "beverages",
          "preparedFood",
          "other"
        ]
      },
      "CategoryResponse": {
        "required": [
          "category",
          "shelfLifeDays"
        ],
        "type": "object",
        "properties": {
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "shelfLifeDays": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          }
        }
      },
      "Dimension": {
        "enum": [
          "mass",
          "volume",
          "count"
        ]
      },
      "IngredientResponse": {
        "required": [
          "id",
          "name",
          "dimension",
          "defaultCategory"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "dimension": {
            "$ref": "#/components/schemas/Dimension"
          },
          "defaultCategory": {
            "$ref": "#/components/schemas/Category"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "MeResponse": {
        "required": [
          "email",
          "householdId"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "householdId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "PantryItemResponse": {
        "required": [
          "id",
          "ingredientId",
          "ingredientName",
          "amount",
          "unit",
          "quantity",
          "category",
          "expiryDate",
          "expiryEstimated",
          "expired",
          "soonExpiring",
          "version"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "ingredientId": {
            "type": "string",
            "format": "uuid"
          },
          "ingredientName": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "unit": {
            "$ref": "#/components/schemas/Unit"
          },
          "quantity": {
            "type": "number",
            "format": "double"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "expiryDate": {
            "type": "string",
            "format": "date"
          },
          "expiryEstimated": {
            "type": "boolean"
          },
          "expired": {
            "type": "boolean"
          },
          "soonExpiring": {
            "type": "boolean"
          },
          "version": {
            "type": "integer",
            "format": "uint32"
          }
        }
      },
      "RegisterRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "maxLength": 256,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "maxLength": 128,
            "minLength": 15,
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Unit": {
        "enum": [
          "g",
          "dkg",
          "kg",
          "ml",
          "dl",
          "l",
          "db"
        ]
      },
      "UpdatePantryItemRequest": {
        "required": [
          "amount",
          "unit",
          "category",
          "version"
        ],
        "type": "object",
        "properties": {
          "amount": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "unit": {
            "type": [
              "null",
              "string"
            ]
          },
          "category": {
            "type": [
              "null",
              "string"
            ]
          },
          "expiryDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          },
          "version": {
            "type": [
              "null",
              "integer"
            ],
            "format": "uint32"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Categories"
    },
    {
      "name": "Ingredients"
    },
    {
      "name": "PantryItems"
    },
    {
      "name": "Auth"
    }
  ]
}