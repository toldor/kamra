<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Identity's SignInManager and the health check abstractions live in the ASP.NET Core shared framework. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR-0005: seed files are embedded, so the migration bundle and the tests read the same data. -->
    <EmbeddedResource Include="Persistence\Seed\*.json" LogicalName="Kamra.Seed.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KamraApp.Application\KamraApp.Application.csproj" />
    <ProjectReference Include="..\KamraApp.Domain\KamraApp.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- AGENTS.md 5.: versioned prompt files; v1 and v2 stay as the measured baselines of ADR-0009. -->
    <EmbeddedResource Include="Llm\Prompts\quick-entry.v3.txt" LogicalName="quick-entry.v3.txt" />
  </ItemGroup>

</Project>
